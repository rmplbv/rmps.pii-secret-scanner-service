# Generate with: openssl rand -base64 32   (keep it: sessions are unreadable without it)
PII_VAULT_KEY=
# Comma-separated API keys for the X-API-Key header. Empty = auth disabled (dev only!)
PII_API_KEYS=
PII_PORT=8000
# CPU threads (machine-dependent). The LLM and worker-full compete for cores.
LLM_THREADS=6
WORKER_THREADS=4
FAST_THREADS=2
LLM_CTX=8192
LLM_FILE=Qwen3-8B-Q4_K_M.gguf
